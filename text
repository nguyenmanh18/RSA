// Tìm số d là nghịch đảo của e
long int FindD(long int phi_n, long int e)
{
    long int a = phi_n, b = e;
    long int x1 = 0, x2 = 1, y1 = 1, y2 = 0, x, y, q, r;
//long int gcd = b;
    while (b!=0)
    {
        q = a/b;
        r = a% b;
        x = x2 - x1 * q;
        y = y2 - y1 * q;
        a = b ;
        b = r;
        x2 = x1;
        x1=x;
        y2 = y1;
        y1=y;
    }
    if (a != 1)
    {
        cout<< "Choose a suitable \"e\" value" <<endl;
        e = FindE(phi_n);
        FindD(phi_n, e);
    }
    x = x2;
    y = y2;
    if(y < 0)
        y = phi_n + y;
    return y;

}

// Thuật toán mã hóa và giải mã
long int Encrypt_Decrypt(long int m, long int e, long int n)
{
    int a[100];
    int k = 0;
    do
    {
        a[k] = e % 2;
        k++;
        e = e / 2;
    }
    while (e != 0);

    //Qua trinh lay du
    int kq = 1;
    for (int i = k - 1; i >= 0; i--)
    {
        kq = (kq * kq) % n;
        if (a[i] == 1)
            kq = (kq * m) % n;
    }
    return kq;
}
