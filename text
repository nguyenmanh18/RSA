//Kiểm tra số nguyên tố
bool CheckIsPrime(long int num)
{
    if(num < 2)
        return false;
    long int i = 2;
    long int temp = sqrt(num);
    while(i <= temp)
    {
        if(!(num % i))
            return false;
        i++;
    }
    return true;
}

// Tìm số nguyên tố khi người dùng nhập không đúng
long int FindPrimeNumberLess(long int num)
{
    long int p;
    printf("%ld is not a prime number!\n", num);
    printf("Do you want to choose a prime number bigger than this number?\n");
    printf("Press Y to choose Yes, press N to choose No\n");
    char ch;
    fflush(stdin);
    scanf("%c", &ch);
    if  (ch == 'y' || ch == 'Y')
    {
        do
        {
            num++;
        }
        while(!CheckIsPrime(num) );
    }
    else
    {
        do
        {
            cout << "Enter a prime number: ";
            cin >> p;
        }
        while(!CheckIsPrime(p));
        num = p;
    }
    return num;

}
