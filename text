    {
        long int p1 = FindPrimeNumberLess(p);
        p = p1;
        printf("So nguyen to dau tien la: %ld\n", p);
    }
    cout << "Nhap so nguyen to thu 2 : ";
    cin >> q;
    if(!CheckIsPrime(q))
    {
        long int q1 = FindPrimeNumberLess(q);
        q = q1;
        printf("So nguyen to thu 2 la : %ld\n", q);
    }
    n = Multiply(p, q);
    cout << "n is " << n << endl;
    phi_n = Multiply(p-1, q-1);
    cout << "phi_n is " << phi_n << endl;
    e = FindE(phi_n);
