long int Multiply(long int num1, long int num2)
{
    return num1 * num2;
}

// Kiểm tra nguyên tố cùng nhau
bool CheckCoPrime (long int num1, long int num2)
{
    //long int r, a, b;
    long int temp;
    bool coprime;
    if (num1 < num2)
    {
        temp = num1;
        num1 = num2;
        num2 = temp;
    }
    while(num2 != 0)
    {
        temp = num1 % num2;
        num1 = num2;
        num2 = temp;
    }
    if(num1 == 1)
        coprime = true;
    else
        coprime = false;
    return coprime;
}

